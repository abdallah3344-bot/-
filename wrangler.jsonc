/**
 * إعدادات نشر نظام إدارة مكتب المحاماة على Cloudflare Workers.
 *
 * المحوّل @opennextjs/cloudflare يشغّل Next.js على وقت تشغيل Node
 * داخل Worker — لا Edge runtime. هذا ما يجعل مكوّنات الخادم
 * و Server Actions و proxy.ts وتعبئة قوالب Word تعمل كما هي.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "masri-law-office-test",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": [
    // لازم لـ Buffer و node:zlib التي تستعملها تعبئة قوالب Word
    "nodejs_compat",
    // يمنع الـ Worker من مناداة نفسه داخليًا عبر fetch
    "global_fetch_strictly_public"
  ],
  /**
   * إسباild داخل wrangler يغلّف الدوال بمساعد __name للحفاظ على
   * أسمائها. مكتبة next-themes تُسلسل دالتها إلى نصّ وتضعه سكربتًا
   * مضمَّنًا في الصفحة، فيخرج المساعد إلى المتصفح حيث لا وجود له
   * ويرمي ReferenceError ويُعطّل منع وميض الوضع الليلي.
   */
  "keep_names": false,
  /**
   * التصغير يُنزل الـ Worker من 3.3 إلى 2.8 ميجابايت مضغوطًا مع
   * scripts/cf-strip-og.mjs — تحت حدّ 3 ميجابايت للخطة المجانية.
   */
  "minify": true,

  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  /**
   * ربط رابط كل مكتب (<slug>.masryps.com) تلقائيًا — src/lib/cloudflare-domains.ts.
   * المفتاح نفسه سرّ يُضاف من لوحة Cloudflare: Settings ← Variables and Secrets
   * باسم CF_API_TOKEN (لا يُكتب هنا).
   */
  // keep_vars: لا تمسح متغيرات أضيفت من اللوحة عند كل نشر
  "keep_vars": true,
  "vars": {
    "CF_ACCOUNT_ID": "684ba792ce69017f95cf59070c35b346",
    "CF_ZONE_ID": "d7ce02a8903c9026c2a179b7aecce546",
    "CF_WORKER_NAME": "masri-law-office"
  },
  "observability": {
    "enabled": true
  }
}
